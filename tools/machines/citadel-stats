#!/usr/bin/python3 -I
"""Citadel's stats script for a Linux machine on the estate: prints one JSON object and exits.

Installed as ~/.local/bin/citadel-stats by tools/machines_setup.py and run only through Citadel's restricted key
(`command="…",restrict` in authorized_keys), so it takes no input and must never need root. Python 3 standard library
only: every Linux machine here has python3, nothing else is assumed (nvidia-smi and vcgencmd are used when present).

`--root DIR` reads /proc and /sys from a fake tree instead (tests); the external tools are skipped then.
"""
from __future__ import annotations

import glob
import json
import os
import shutil
import subprocess
import sys
import time

VERSION = 1
ROOT = ""
SAMPLE = 0.5          # seconds between the two /proc/stat reads that give CPU %

# Filesystems that aren't this machine's own disks. Network ones matter most: statting NZXT's /mnt/Films would
# wake an automount (and hang if Nasferatu is off).
SKIP_FS = {"tmpfs", "devtmpfs", "overlay", "squashfs", "autofs", "cifs", "smb3", "nfs", "nfs4", "iso9660", "ramfs", "efivarfs"}


def path(p: str) -> str:
    return ROOT + p


def read(p: str) -> str:
    with open(path(p)) as f:
        return f.read()


def maybe(p: str) -> str | None:
    try:
        return read(p).strip()
    except OSError:
        return None


def run(argv: list[str]) -> str | None:
    if ROOT or not shutil.which(argv[0]):
        return None
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=4)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def cpu_ticks() -> tuple[int, int, int]:
    """(idle, total, cores) from /proc/stat."""
    lines = read("/proc/stat").splitlines()
    nums = [int(x) for x in lines[0].split()[1:]]
    cores = sum(1 for l in lines[1:] if l.startswith("cpu"))
    return nums[3] + nums[4], sum(nums), cores


def proc_ticks() -> dict[int, tuple[str, int]]:
    """pid -> (name, utime + stime) for every process, from /proc/<pid>/stat. The name is in brackets and may hold
    spaces or brackets itself, so it's everything between the first "(" and the last ")"."""
    out: dict[int, tuple[str, int]] = {}
    for d in glob.glob(path("/proc/[0-9]*")):
        try:
            with open(d + "/stat") as f:
                raw = f.read()
        except OSError:                  # gone since the glob
            continue
        name, rest = raw[raw.find("(") + 1:raw.rfind(")")], raw[raw.rfind(")") + 2:].split()
        try:
            out[int(d.rsplit("/", 1)[1])] = (name, int(rest[11]) + int(rest[12]))
        except (ValueError, IndexError):
            continue
    return out


def top_procs(a: dict[int, tuple[str, int]], b: dict[int, tuple[str, int]], total: int, n: int = 5) -> list[dict]:
    """The busiest process names over the sample, as % of the whole machine (all cores), same-named processes summed
    (a browser's dozens of helpers are one line). Both /proc/stat and /proc/<pid>/stat count in the same clock ticks."""
    if total <= 0:
        return []
    by_name: dict[str, int] = {}
    for pid, (name, t) in b.items():
        if pid in a and a[pid][0] == name and t > a[pid][1]:
            by_name[name] = by_name.get(name, 0) + t - a[pid][1]
    rows = sorted(by_name.items(), key=lambda kv: -kv[1])[:n]
    return [{"name": k, "percent": round(100 * v / total, 1)} for k, v in rows if 100 * v / total >= 0.5]


def cpu_percent(a: tuple[int, int, int], b: tuple[int, int, int]) -> float | None:
    if b[1] == a[1]:
        return None
    return round(100 * (1 - (b[0] - a[0]) / (b[1] - a[1])), 1)


def hwmons() -> dict[str, str]:
    """hwmon name -> its directory (first one of each name)."""
    out: dict[str, str] = {}
    for d in sorted(glob.glob(path("/sys/class/hwmon/hwmon*"))):
        name = maybe(d[len(ROOT):] + "/name")
        if name and name not in out:
            out[name] = d[len(ROOT):]
    return out


def hwmon_temp(d: str, labels: tuple[str, ...] = ()) -> float | None:
    """The temperature labelled with the first of `labels` found, else temp1."""
    for want in labels:
        for f in sorted(glob.glob(path(d + "/temp*_label"))):
            if (maybe(f[len(ROOT):]) or "") == want:
                v = maybe(f[len(ROOT):].replace("_label", "_input"))
                return round(int(v) / 1000, 1) if v else None
    v = maybe(d + "/temp1_input")
    return round(int(v) / 1000, 1) if v else None


def cpu_temp(mons: dict[str, str]) -> float | None:
    if "k10temp" in mons:                     # AMD: Tctl on Ryzen; the Phenom in Phoenix has only an unlabelled temp1
        return hwmon_temp(mons["k10temp"], ("Tctl", "Tdie"))
    if "zenpower" in mons:
        return hwmon_temp(mons["zenpower"], ("Tdie", "Tctl"))
    if "coretemp" in mons:                    # Intel: the package sensor
        return hwmon_temp(mons["coretemp"], ("Package id 0",))
    if "cpu_thermal" in mons:                 # Raspberry Pi
        return hwmon_temp(mons["cpu_thermal"])
    return None


def mem() -> dict[str, int]:
    raw = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l)}
    return {"total": raw["MemTotal"], "used": raw["MemTotal"] - raw["MemAvailable"], "available": raw["MemAvailable"],
            "swap_total": raw.get("SwapTotal", 0), "swap_used": raw.get("SwapTotal", 0) - raw.get("SwapFree", 0),
            "buffers": raw.get("Buffers", 0), "cached": raw.get("Cached", 0)}


def disks() -> list[dict]:
    """Each local disk once (btrfs subvolumes share a device: keep the shortest mount point, normally /)."""
    by_dev: dict[str, str] = {}
    for line in read("/proc/mounts").splitlines():
        dev, mnt, fs = line.split()[:3]
        mnt = mnt.replace("\\040", " ")
        if fs in SKIP_FS or fs.startswith("fuse") or not dev.startswith("/dev/") or dev.startswith("/dev/loop") or mnt.startswith("/boot"):
            continue
        if dev not in by_dev or len(mnt) < len(by_dev[dev]):
            by_dev[dev] = mnt
    out = []
    for mnt in sorted(set(by_dev.values())):
        try:
            st = os.statvfs(path(mnt) if ROOT else mnt)
        except OSError:
            continue
        out.append({"mount": mnt, "total": st.f_blocks * st.f_frsize, "free": st.f_bavail * st.f_frsize})
    return out


def gpu(mons: dict[str, str]) -> dict | None:
    out = run(["nvidia-smi", "--query-gpu=name,utilization.gpu,temperature.gpu,memory.used,memory.total", "--format=csv,noheader,nounits"])
    if out and out.strip():
        parts = [p.strip() for p in out.strip().splitlines()[0].split(",")]
        if len(parts) == 5:
            def num(v: str) -> float | None:
                try:
                    return float(v)
                except ValueError:
                    return None
            return {"name": parts[0], "percent": num(parts[1]), "temp": num(parts[2]), "mem_used_mb": num(parts[3]), "mem_total_mb": num(parts[4])}
    for name in ("amdgpu", "radeon", "nouveau"):          # the drivers give just the temperature…
        if name in mons:
            out = {"name": {"amdgpu": "AMD Radeon", "radeon": "AMD Radeon", "nouveau": "NVIDIA"}[name], "percent": None,
                   "temp": hwmon_temp(mons[name], ("edge",)), "mem_used_mb": None, "mem_total_mb": None}
            if name != "nouveau":                          # …and radeontop, when installed, the load and VRAM (Phoenix)
                out.update(radeontop(run(["radeontop", "-d", "-", "-l", "1"])))
            return out
    return None


def radeontop(text: str | None) -> dict:
    """One `radeontop -d - -l 1` line (a second's sample, no root needed) →
    "…: bus 01, gpu 2.50%, ee 0.00%, …, vram 43.14% 441.77mb, gtt …" → load %, VRAM used and total in MB."""
    out: dict = {}
    line = next((l for l in (text or "").splitlines() if ": bus " in l), None)
    if not line:
        return out
    for part in line.split(": ", 1)[1].split(", "):
        bits = part.split()
        try:
            if bits[0] == "gpu":
                out["percent"] = round(float(bits[1].rstrip("%")), 1)
            elif bits[0] == "vram" and len(bits) == 3:
                pct, used = float(bits[1].rstrip("%")), float(bits[2].rstrip("mb"))
                out["mem_used_mb"] = round(used)
                if pct > 0:
                    out["mem_total_mb"] = round(used * 100 / pct)
        except (ValueError, IndexError):
            continue
    return out


def battery() -> dict | None:
    for d in sorted(glob.glob(path("/sys/class/power_supply/BAT*"))):
        cap = maybe(d[len(ROOT):] + "/capacity")
        if cap is not None:
            return {"percent": int(cap), "status": maybe(d[len(ROOT):] + "/status") or "Unknown"}
    return None


def pi_power(text: str | None) -> dict | None:
    """`vcgencmd get_throttled` → throttled=0x50005. Bit 0: under-voltage now, bit 16: under-voltage since boot."""
    if not text or "=" not in text:
        return None
    try:
        bits = int(text.strip().split("=", 1)[1], 16)
    except ValueError:
        return None
    return {"throttled": hex(bits), "under_voltage_now": bool(bits & 0x1), "under_voltage_seen": bool(bits & 0x10000)}


def os_name() -> str | None:
    rel = dict(l.split("=", 1) for l in (maybe("/etc/os-release") or "").splitlines() if "=" in l)
    rel = {k: v.strip().strip('"') for k, v in rel.items()}
    if rel.get("ID") == "debian" and maybe("/etc/rpi-issue") is not None:     # Raspberry Pi OS says it's plain Debian
        return f"Raspberry Pi OS (Debian {rel['VERSION_ID']})" if rel.get("VERSION_ID") else "Raspberry Pi OS"
    return rel.get("PRETTY_NAME")


def cpuinfo(key: str) -> str | None:
    """The first `key : value` line of /proc/cpuinfo (x86 says "model name"; a Pi says "Model" and "CPU part")."""
    for line in (maybe("/proc/cpuinfo") or "").splitlines():
        k, _, v = line.partition(":")
        if k.strip() == key and v.strip():
            return v.strip()
    return None


def gpus_lspci(text: str | None) -> list[dict]:
    """Graphics cards from `lspci -mm`: `08:00.0 "VGA compatible controller" "NVIDIA Corporation" "GA102 [GeForce RTX
    3080 Ti]" -ra1 …`. Citadel tidies the names (app/machines.py)."""
    import shlex
    out = []
    for line in (text or "").splitlines():
        try:
            parts = shlex.split(line)
        except ValueError:
            continue
        if len(parts) >= 4 and any(w in parts[1] for w in ("VGA", "3D", "Display")):
            out.append({"vendor": parts[2], "device": parts[3]})
    return out


def memory_modules(text: str | None) -> list[dict]:
    """The memory sticks, from udev's copy of the firmware's table (`udevadm info -p /sys/devices/virtual/dmi/id`: its
    dmi_memory_id reads it at boot, so no root is needed, unlike dmidecode). Empty slots are left out. An old BIOS may
    say "Other" or "Unknown" for the type (Phoenix): Citadel fills that in from the board."""
    props = dict(l.split("=", 1) for l in (text or "").splitlines() if l.startswith("MEMORY_DEVICE_") and "=" in l)
    out = []
    for i in sorted({int(k.split("_")[2]) for k in props if k.split("_")[2].isdigit()}):
        get = lambda f: props.get(f"MEMORY_DEVICE_{i}_{f}")
        if get("PRESENT") == "0" or not (get("SIZE") or "").isdigit():
            continue
        speed = get("CONFIGURED_SPEED_MTS") or get("SPEED_MTS")
        out.append({"type": get("TYPE"), "size": int(get("SIZE")), "mts": int(speed) if speed and speed.isdigit() else None, "form": get("FORM_FACTOR")})
    return out


def spec() -> dict:
    """What the machine is: kept with the latest reading only (the collector stores no history of it), for the Fleet
    page's Specifications card. No root needed: dmidecode would give the memory type, but it isn't worth sudo."""
    cores = {(maybe(d + "/topology/physical_package_id"), maybe(d + "/topology/core_id"))
             for d in (p[len(ROOT):] for p in glob.glob(path("/sys/devices/system/cpu/cpu[0-9]*")))}
    cores.discard((None, None))
    threads = cpu_ticks()[2]
    maxf = maybe("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    dmi = {k: maybe("/sys/class/dmi/id/" + k) for k in ("sys_vendor", "product_name", "product_version", "board_vendor", "board_name")}
    u = os.uname()
    return {
        "model": cpuinfo("Model") or (maybe("/proc/device-tree/model") or "").strip("\0") or None,
        "dmi": {k: v for k, v in dmi.items() if v} or None,
        "cpu": cpuinfo("model name"),
        "cpu_part": cpuinfo("CPU part"),
        "cores": len(cores) or threads,
        "threads": threads,
        "max_mhz": round(int(maxf) / 1000) if maxf and maxf.isdigit() else None,
        "gpus": gpus_lspci(run(["lspci", "-mm"])),
        "ram": memory_modules(run(["udevadm", "info", "-q", "property", "-p", "/sys/devices/virtual/dmi/id"])),
        "kernel": u.release,
        "arch": u.machine,
    }


def collect() -> dict:
    a, pa = cpu_ticks(), proc_ticks()
    if SAMPLE:
        time.sleep(SAMPLE)
    b, pb = cpu_ticks(), proc_ticks()
    mons = hwmons()
    return {
        "v": VERSION,
        "host": maybe("/proc/sys/kernel/hostname"),
        "os": os_name(),
        "uptime_s": int(float(read("/proc/uptime").split()[0])),
        "load": [float(x) for x in read("/proc/loadavg").split()[:3]],
        "cpu": {"percent": cpu_percent(a, b), "cores": b[2], "temp": cpu_temp(mons)},
        "mem": mem(),
        "disks": disks(),
        "gpu": gpu(mons),
        "battery": battery(),
        "pi": pi_power(run(["vcgencmd", "get_throttled"])),
        "top": top_procs(pa, pb, b[1] - a[1]),
        "spec": spec(),
    }


def main(argv: list[str]) -> int:
    global ROOT, SAMPLE
    if len(argv) == 3 and argv[1] == "--root":
        ROOT, SAMPLE = argv[2].rstrip("/"), 0
    print(json.dumps(collect(), separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
